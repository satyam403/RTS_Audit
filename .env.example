# =============================================================================
# Copy this file to `.env` and fill in the real values. `.env` is gitignored.
# =============================================================================

# --- RTS Pro logins (one pair per account) -----------------------------------
RTS_USER=
RTS_PASS=

RTS_CHANDI_USER=
RTS_CHANDI_PASS=

RTS_313_USER=
RTS_313_PASS=

# --- Airtable ----------------------------------------------------------------
# Personal access token with data.records:read + data.records:write on the base.
AIRTABLE_TOKEN=

# --- Email alerts (daily.js emails you when a report fails) -------------------
# Gmail / Google Workspace: host smtp.gmail.com, port 587, and SMTP_PASS must be
# an App Password (https://myaccount.google.com/apppasswords) — your normal
# account password will be rejected.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@handatransportation.com
SMTP_PASS=
ALERT_TO=admin@handatransportation.com
# ALERT_FROM=            # defaults to SMTP_USER
# ALERT_ON_SUCCESS=1     # also email on a fully clean run (default: only on problems)

# --- Daily run tuning (all optional, sane defaults in daily.js) ---------------
# RTS_LOOKBACK_DAYS=30       # size of the rolling window
# RTS_ATTEMPTS=2             # attempts per report before giving up
# RTS_RETRY_DELAY_MS=60000   # wait between attempts
# RTS_JOB_TIMEOUT_MIN=30     # per-report ceiling
# RTS_RUN_TIMEOUT_MIN=240    # whole-run watchdog
# RTS_KEEP_DOWNLOADS_DAYS=7  # prune downloads/ older than this
# RTS_KEEP_LOGS_DAYS=30      # prune logs/ older than this
# RTS_HEADLESS=0             # set to 0 to watch the browser during a manual run
